{
  "processed_dir": "data/processed",
  "causal_dataset_csv": "data/interim/causal_dataset.csv",
  "phase2_artifacts_dir": "artifacts/phase2",
  "phase2_reports_dir": "reports/phase2",
  "phase3_artifacts_dir": "artifacts/phase3",
  "phase3_reports_dir": "reports/phase3",
  "random_seed": 42,
  "window_seconds": 60,
  "graph_splits": {
    "train": "train",
    "validation": "validation",
    "test": "test"
  },
  "expected_schema": {
    "node_features": 7,
    "edge_features": 66
  },
  "model": {
    "hidden_dim": 64,
    "embedding_dim": 64,
    "num_layers": 2,
    "attention_heads": 4,
    "dropout": 0.2
  },
  "training": {
    "device": "cpu",
    "batch_size": 32,
    "epochs": 200,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "early_stopping_patience": 25,
    "minimum_improvement": 0.000001,
    "current_loss_weight": 1.0,
    "next_loss_weight": 0.5,
    "num_workers": 0
  },
  "reports": {
    "generate_plots": true
  },
  "overwrite_outputs": false
}
