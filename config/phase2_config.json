{
  "processed_dir": "data/processed",
  "phase1_artifacts_dir": "artifacts",
  "interim_dir": "data/interim",
  "phase2_artifacts_dir": "artifacts/phase2",
  "phase2_reports_dir": "reports/phase2",
  "causal_dataset_csv": "data/interim/causal_dataset.csv",
  "random_seed": 42,
  "window_seconds": 60,
  "graph_splits": {
    "train": "train",
    "validation": "validation",
    "test": "test"
  },
  "dataset": {
    "minimum_rows_per_split": {
      "train": 20,
      "validation": 1
    },
    "correlation_redundancy_threshold": 0.995
  },
  "reports": {
    "generate_plots": true
  },
  "discovery": {
    "method": "notears",
    "edge_weight_threshold": 0.08,
    "notears": {
      "lambda1": 0.01,
      "loss_type": "l2",
      "max_iter": 80,
      "h_tol": 1e-8,
      "rho_max": 10000000000000000.0,
      "w_threshold": 0.0
    }
  },
  "constraints": {
    "forbidden_edges": [],
    "required_edges": []
  },
  "stability": {
    "enabled": true,
    "n_bootstraps": 12,
    "subsample_fraction": 0.8,
    "random_seeds": [11, 23, 37, 41, 53, 67, 79, 83, 97, 101, 113, 127],
    "edge_weight_threshold": 0.08,
    "minimum_stability": 0.5
  },
  "scm": {
    "model_type": "linear_regression"
  }
}
